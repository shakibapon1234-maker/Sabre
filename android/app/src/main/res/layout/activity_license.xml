<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141A24"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#4FD1C5"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:text="@string/license_prompt"
        android:textColor="#B8C4D0"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/licenseKeyInput"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="#1E2733"
        android:gravity="center"
        android:hint="SBR-XXXX-XXXX-XXXX"
        android:inputType="textCapCharacters"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#5A6B7A"
        android:textSize="16sp" />

    <Button
        android:id="@+id/activateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#4FD1C5"
        android:paddingLeft="24dp"
        android:paddingTop="10dp"
        android:paddingRight="24dp"
        android:paddingBottom="10dp"
        android:text="@string/license_activate_button"
        android:textColor="#141A24"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/licenseStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#E0A030"
        android:textSize="13sp" />

</LinearLayout>
